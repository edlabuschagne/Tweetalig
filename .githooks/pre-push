#!/bin/sh

zero_oid="0000000000000000000000000000000000000000"

while read -r local_ref local_oid remote_ref remote_oid
do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "FORGE GUARD: direct pushes to main are blocked. Use a pull request." >&2
    exit 1
  fi

  case "$local_oid" in
    "$zero_oid"*)
      echo "FORGE GUARD: remote branch deletion is blocked: $remote_ref" >&2
      exit 1
      ;;
  esac

  case "$remote_ref" in
    refs/heads/*)
      case "$remote_oid" in
        "$zero_oid"*) ;;
        *)
          if ! git merge-base --is-ancestor "$remote_oid" "$local_oid"
          then
            echo "FORGE GUARD: non-fast-forward pushes are blocked: $remote_ref" >&2
            exit 1
          fi
          ;;
      esac
      ;;
  esac
done

exit 0
